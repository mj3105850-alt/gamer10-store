# Variáveis de Ambiente - GAMES 10

# ========== AMBIENTE ==========
NODE_ENV=development
PORT=3000

# ========== BANCO DE DADOS ==========
# Para desenvolvimento local use sqlite
DATABASE_URL=sqlite://./database.sqlite

# Para produção, use PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/games10

# ========== SEGURANÇA ==========
# Gere uma chave forte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=sua-chave-super-secreta-gere-uma-nova-aqui-aleatorio
JWT_SECRET=seu-jwt-secret-tambem-aleatorio-gerado

# Senha do primeiro admin (será hasheada no banco)
ADMIN_PASSWORD=SenhaForte123!@#

# ========== PIX ==========
# Credenciais do seu provedor Pix
PIX_PROVIDER=efiseller  # efiseller, asaas, stripe, vindi
PIX_API_KEY=sua-chave-api-pix
PIX_CLIENT_ID=seu-client-id
PIX_CLIENT_SECRET=seu-client-secret
PIX_WEBHOOK_SECRET=seu-webhook-secret

# Dados para recebimento Pix
PIX_RECEIVER_NAME=Seu Nome Aqui
PIX_RECEIVER_CPF=00000000000
PIX_RECEIVER_CITY=São Paulo
PIX_RECEIVER_PHONE=11999999999

# ========== DOWNLOAD ==========
# Tempo de validade do link (em horas)
DOWNLOAD_TOKEN_EXPIRY=24

# Quantidade máxima de downloads por pedido
DOWNLOAD_MAX_COUNT=3

# Tamanho máximo de arquivo (em MB)
MAX_FILE_SIZE=5000

# ========== EMAIL ==========
# Se quiser enviar emails de confirmação
SMTP_HOST=smtp.seuservidor.com
SMTP_PORT=587
SMTP_USER=seu-email@seuservidor.com
SMTP_PASS=sua-senha-email
SMTP_FROM=noreply@games10.com

# ========== LOJA ==========
# Moeda (não mude, apenas R$ por enquanto)
CURRENCY=BRL

# Preço padrão de produtos (em centavos: 500 = R$ 5,00)
DEFAULT_PRICE=500

# ========== CORS ==========
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ========== LOGS ==========
LOG_LEVEL=debug  # debug, info, warn, error

# ========== STORAGE ==========
# Pasta para armazenar arquivos privados
STORAGE_PATH=./storage/private

# ========== BACKUP ==========
# Configuração de backup automático
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # 2AM todos os dias
